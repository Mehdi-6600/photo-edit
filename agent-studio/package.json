{
  "name": "agent-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first control room that coordinates open-source AI coding agents through GitHub and Vercel.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
