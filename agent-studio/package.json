  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@next/eslint-plugin-next": "16.3.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
