# Agent Studio configuration. Copy to .env.local for local work, or enter these values in
# Vercel under Project > Settings > Environment Variables. Never commit real values.
# Every value below is a placeholder.

# ---- Owner access (required) -------------------------------------------------
# Long random string, 32+ characters. Unlocks the workspace. Generate one with: openssl rand -hex 32
APP_ACCESS_TOKEN=replace-with-a-long-random-string-of-32-plus-chars

# ---- GitHub (required for code work) -----------------------------------------
# Fine-grained token limited to ONE repository. Permissions: Contents (read and write),
# Pull requests (read and write), Actions (read), Checks (read), Metadata (read).
GITHUB_TOKEN=github_pat_replace_me
# owner/name of the repository agents may work in.
GITHUB_REPOSITORY=owner/name
AGENT_GIT_AUTHOR_NAME=agent-studio[bot]
AGENT_GIT_AUTHOR_EMAIL=agent-studio@users.noreply.github.com
# Comma-separated path prefixes that agents may change. Protected paths are always refused.
AGENT_ALLOWED_PATHS=app/,components/,lib/,src/,tests/,test/,docs/,public/,agent-studio/,README.md
# Set to true only if you want Agent Studio to merge pull requests after your APPROVE.
AGENT_STUDIO_ALLOW_MERGE=false

# ---- Free AI model (required for agents to write code) -----------------------
# Any OpenAI-compatible Chat Completions endpoint. Pick one with a free tier and check its
# current limits. Examples:
#   Google AI Studio (free tier): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter (":free" models):  LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama on your own computer (not reachable from Vercel): LLM_BASE_URL=http://localhost:11434/v1
LLM_BASE_URL=https://your-openai-compatible-endpoint.example/v1
LLM_MODEL=your-free-model-name
LLM_API_KEY=replace-with-your-free-tier-key
LLM_TIMEOUT_MS=45000

# ---- Vercel (optional) -------------------------------------------------------
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Deploy hook URL from Vercel > Project > Settings > Git > Deploy Hooks. Treat it as a secret.
VERCEL_DEPLOY_HOOK_URL=
# Public production URL used by the "verify production" step.
PRODUCTION_URL=https://your-project.example.com

# ---- Persistent storage (recommended; Upstash Redis free tier) ----------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Local development only --------------------------------------------------
AGENT_STUDIO_DATA_DIR=.data
