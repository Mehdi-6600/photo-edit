# Agent Studio configuration. Copy to .env.local for local work, or add these values in the
# existing Vercel project's Environment Variables. Credentials are placeholders; the repository
# setting below intentionally locks the app to this project unless you change or remove it.
# Never commit real values or paste credentials into issues, logs, or chat.

# ---- Owner access (required) -------------------------------------------------
# Long random string (32+ characters). Example generator: openssl rand -hex 32
APP_ACCESS_TOKEN=CHANGE_ME

# ---- GitHub (required for repository work) -----------------------------------
# Fine-grained token limited to ONE repository where possible.
# Minimum permissions: Metadata (read), Contents (read/write), Pull requests (read/write),
# Actions (read), Checks (read). Do not grant workflow or organization administration.
GITHUB_TOKEN=github_pat_replace_me
# Optional hard lock. When set, the UI cannot select or operate on a different repository.
# If omitted, the owner may choose any repository this token can access.
GITHUB_REPOSITORY=Mehdi-6600/photo-edit
AGENT_GIT_AUTHOR_NAME=agent-studio[bot]
AGENT_GIT_AUTHOR_EMAIL=agent-studio@users.noreply.github.com
# Comma-separated prefixes the model patch adapter may change. Protected paths are always refused.
AGENT_ALLOWED_PATHS=app/,components/,lib/,src/,tests/,test/,docs/,public/,data/,scripts/,README.md
# Automatic merge is off unless explicitly enabled; owner approval is always required.
AGENT_STUDIO_ALLOW_MERGE=false

# ---- OpenAI-compatible model (optional for planning, required for code generation) ----
# Examples (check current model names, free quotas and provider data terms):
# Google AI Studio: https://generativelanguage.googleapis.com/v1beta/openai
# OpenRouter:       https://openrouter.ai/api/v1
# Self-hosted Ollama: http://localhost:11434/v1 (only when the app server can reach that host)
LLM_BASE_URL=https://your-openai-compatible-endpoint.example/v1
LLM_MODEL=your-model-name
LLM_API_KEY=replace-with-your-model-key
LLM_TIMEOUT_MS=30000

# ---- Vercel (optional) -------------------------------------------------------
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Treat a Vercel deploy-hook URL as a secret. DEPLOY gates this hook only; Vercel Git may deploy on merge.
VERCEL_DEPLOY_HOOK_URL=
# Public production URL used by the server-side HTTPS check.
PRODUCTION_URL=https://your-project.example.com

# ---- Persistent storage (recommended on Vercel) ------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Local development only --------------------------------------------------
AGENT_STUDIO_DATA_DIR=.data
